/.venv/
**/__pycache__/
*.py[cod]
/.python-version
/.pytest_cache/
/.ruff_cache/
/.mypy_cache/
/.coverage
/htmlcov/
*.egg-info/

# Legacy harness outputs
/results.tsv
/run.log
/benchmark_*/
