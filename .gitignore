# Local secrets are never repository artifacts. Production evaluator secrets
# belong in an OS secret store outside the Codex workspace, not merely here.
/.env
/.env.*
!/.env.example
/.secrets/
*.secret
*.key

# Codex client-local configuration is personal state; tracked prompts live in
# /meta_agent instead.
/.codex/

# Operating-system files
.DS_Store
